# Copier ce fichier vers .env.local et renseigner les valeurs.
# .env.local n'est jamais versionné.

# --- Envoi des commandes (Resend) ---
# Secret. Serveur uniquement : ne jamais préfixer par NEXT_PUBLIC_.
RESEND_API_KEY=

# Boîte PARTAGÉE et surveillée. Jamais une adresse nominative.
ORDER_EMAIL_TO=commandes@example.com

# Adresse de secours, reçoit une copie de chaque commande.
ORDER_EMAIL_BCC=

# Doit appartenir à un domaine authentifié SPF + DKIM + DMARC,
# sinon les commandes partiront en spam.
ORDER_EMAIL_FROM=commandes@example.com

# --- Anti-abus (Cloudflare Turnstile) ---
# Le formulaire de commande déclenche un envoi d'email :
# sans cette protection, c'est un relais de spam ouvert.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Code promo médecin ---
# Secret. Serveur uniquement : ne JAMAIS préfixer par NEXT_PUBLIC_.
# Sans valeur, aucun code n'est accepté (pas de repli permissif).
# La grille de tarifs remisés vit dans data/pricing-doctor.server.json,
# protégée par le paquet `server-only` : elle n'atteint jamais le navigateur.
DOCTOR_CODE=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
